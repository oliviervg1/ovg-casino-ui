{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores user profile information, virtual balance, and theme preference.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique user ID from Firebase Auth."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "photoURL": {
          "type": "string",
          "description": "The user's profile photo URL."
        },
        "balance": {
          "type": "number",
          "description": "The user's current virtual balance."
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark", "sweets", "egypt"],
          "description": "The user's preferred theme."
        }
      },
      "required": ["uid", "email", "balance", "theme"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Collection of user profiles."
    }
  }
}
