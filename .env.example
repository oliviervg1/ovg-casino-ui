# === Server (read by Express via process.env) ===
# GCS bucket holding generated assets and music. Created by deploy/deploy.sh setup.
GCS_BUCKET=
# Optional: Firebase project ID. On Cloud Run, firebase-admin auto-detects
# via GOOGLE_CLOUD_PROJECT (set by the platform), so this is only needed
# for local dev where ADC may not have a project set.
FIREBASE_PROJECT_ID=
# Optional: target a named Firestore database (instead of (default)).
# Server uses getFirestore(app, id) when set; client uses VITE_FIREBASE_DATABASE_ID.
FIRESTORE_DATABASE_ID=
# Local-dev only: when running with user ADC (e.g. Cloud Shell, gcloud auth
# application-default login), V4 signed-URL generation fails with "Gaia id
# not found" because user creds have no SA identity for iamcredentials.signBlob.
# Set this to a service account email that the user can impersonate
# (caller needs roles/iam.serviceAccountTokenCreator on it). The default
# Compute SA, <PROJECT_NUMBER>-compute@developer.gserviceaccount.com, works.
# Leave unset on Cloud Run — the attached runtime SA signs as itself.
SIGNER_SA_EMAIL=
# Optional: server port (defaults to 8080; deploy/cloudbuild.yaml pins Cloud Run to 8080).
PORT=8080
# Optional: per-uid generation rate limit, Gemini/Lyria calls per minute
# (default 30). Counts only cache-miss GETs and POST /regenerate; cache-hit
# GETs (HEAD + sign existing GCS object) are not rate-limited.
RATE_LIMIT_RPM=30
# Optional: per-uid daily regen quota — caps total POST /regenerate calls per user per UTC day.
# Default 200 ≈ 1.9 full Profile-page Regenerate-Assets cycles (105 POSTs each: 81 image + 24 music).
REGEN_RATE_LIMIT_PER_DAY=200
# Optional: signed URL TTL in seconds (default 3600 = 1 hour, max 604800 = 7 days).
SIGNED_URL_TTL_SEC=3600

# === Server secret — DO NOT COMMIT ===
# Set via Secret Manager in prod (`gcloud secrets versions add gemini-api-key`); only used in .env locally.
GEMINI_API_KEY=

# === Client (baked into Vite bundle at build time as import.meta.env.VITE_*) ===
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# === Optional: CES Messenger widget (omit to strip from build) ===
VITE_CES_DEPLOYMENT_ID=
VITE_CES_TOKEN_BROKER_URL=
VITE_CES_CHAT_TITLE=
VITE_CES_THEME_ID=
